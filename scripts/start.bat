@echo off
setlocal EnableExtensions
echo ================================================================
echo                Digital Mechanic - Startup Script
echo ================================================================
echo.

:: ----------------------------------------------------------------
:: CONFIGURATION
:: ----------------------------------------------------------------
:: Public port of the API/UI process (the reverse proxy on the VPS
:: forwards a site subpath to this port through the tunnel).
set PORT=8011
set HOST=0.0.0.0

:: Mock integration services (ML diagnostics and maintenance system).
set ML_PORT=8001
set TOIR_PORT=8002

:: RAG manual-search service (rag\, participant B).
set RAG_PORT=8003

:: Optional HTTPS: voice input on iOS/Safari requires a secure context.
:: Set SSL_CERTFILE/SSL_KEYFILE in the console before running this script,
:: pointing them at the pair generated by scripts\generate_cert.py:
::   set SSL_CERTFILE=certs\dev-cert.pem
::   set SSL_KEYFILE=certs\dev-key.pem
:: (The variables are read from the environment and are NOT cleared here.)
set "SSL_ARGS="
set "SCHEME=http"

:: ----------------------------------------------------------------
:: Resolve repo root (this script lives in scripts\)
:: ----------------------------------------------------------------
pushd "%~dp0.."
set "REPO=%CD%"
popd

if not exist "%REPO%\.venv\Scripts\python.exe" (
    echo ERROR: .venv not found in %REPO%
    echo Create it first:  python -m venv .venv
    echo then:             .venv\Scripts\pip install -e ".[dev]"
    pause
    exit /b 1
)

:: ----------------------------------------------------------------
:: [1/2] Frontend build - served statically by the API process.
:: The vite build uses a relative base, so one static/dist works
:: both at the server root and behind a subpath reverse proxy.
:: Stale-bundle guard: the bundle is rebuilt when it is missing OR
:: older than the sources (a git pull without npm build must not
:: serve the old UI).
:: ----------------------------------------------------------------
if exist "%REPO%\static\dist\index.html" goto front_exists
goto front_build
:front_exists
"%REPO%\.venv\Scripts\python.exe" -c "import os,sys;d=r'%REPO%\frontend\src';i=r'%REPO%\static\dist\index.html';sys.exit(1 if os.path.getmtime(i)<max((os.path.getmtime(os.path.join(r,f)) for r,_,fs in os.walk(d) for f in fs),default=0) else 0)"
if not errorlevel 1 goto front_up_to_date
:front_build
echo [1/2] Building frontend (missing or older than sources)...
pushd "%REPO%\frontend"
call npm run build
if errorlevel 1 (
    popd
    echo ERROR: frontend build failed
    pause
    exit /b 1
)
popd
goto front_done
:front_up_to_date
echo [1/2] Frontend build up to date: static\dist
:front_done
echo.

:: ----------------------------------------------------------------
:: [2/2] Start mock services in separate windows, then the API.
:: The stubs need MOCK_DATA_PATH pointing at the issued fleet file.
:: ----------------------------------------------------------------
echo [2/2] Starting services...
set "MOCK_DATA_PATH=%REPO%\data\vehicles.json"
start "DM mock ML :%ML_PORT%" /min cmd /k ""%REPO%\.venv\Scripts\python.exe" -m uvicorn mock_ml.app:app --port %ML_PORT% --app-dir "%REPO%\vendor""
start "DM mock TOiR :%TOIR_PORT%" /min cmd /k ""%REPO%\.venv\Scripts\python.exe" -m uvicorn mock_toir.app:app --port %TOIR_PORT% --app-dir "%REPO%\vendor""

:: RAG manual-search service - optional: when it is down the backend
:: falls back to mock chunks. rag's relative default paths (data\rag,
:: data\manuals) resolve against the process CWD, so the window is
:: started with /D "%REPO%".
set "RAG_API_URL=http://127.0.0.1:%RAG_PORT%"
if not exist "%REPO%\data\rag\current.json" goto rag_no_index
pushd "%REPO%"
".venv\Scripts\python.exe" -c "import rag.service" >nul 2>&1
if errorlevel 1 (
    popd
    goto rag_no_deps
)
popd
start "DM RAG :%RAG_PORT%" /min /D "%REPO%" cmd /k ""%REPO%\.venv\Scripts\python.exe" -m uvicorn rag.service:app --port %RAG_PORT% --app-dir "%REPO%""
goto rag_done
:rag_no_index
echo [start] RAG skipped: no index - build it first: python -m rag.setup --from "C:\path\to\pdfs"
goto rag_done
:rag_no_deps
echo [start] RAG skipped: deps missing - install: .venv\Scripts\pip install -r rag\requirements.txt
:rag_done

echo.
if defined SSL_CERTFILE if defined SSL_KEYFILE (
    set "SCHEME=https"
    set "SSL_ARGS=--ssl-certfile "%SSL_CERTFILE%" --ssl-keyfile "%SSL_KEYFILE%""
)
echo ----------------------------------------------------------------
echo   API + UI:  %SCHEME%://localhost:%PORT%/
echo   Health:    %SCHEME%://localhost:%PORT%/health
echo   Mocks:     ML :%ML_PORT%, TOiR :%TOIR_PORT%, RAG :%RAG_PORT% (separate windows)
echo   Press Ctrl+C to stop the API server
echo ----------------------------------------------------------------
echo.
:: Stale-backend guard: an old API process on %PORT% makes uvicorn exit
:: with "address already in use" - warn explicitly (observed on the stand).
netstat -ano | find ":%PORT% " | find "LISTENING" >nul 2>&1
if not errorlevel 1 echo WARNING: port %PORT% already in use - stop the old API process first.
cd /d "%REPO%"
.venv\Scripts\python.exe -m uvicorn mechanic.main:app --host %HOST% --port %PORT% %SSL_ARGS%

echo.
echo API server stopped.
pause
