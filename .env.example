# Digital Mechanic — environment configuration sample.
# Copy to .env and adjust. URLs of mock services are required (spec F6).

# --- Mock service URLs (specification v6, F6) ---
ML_API_URL=http://127.0.0.1:8001
TOIR_API_URL=http://127.0.0.1:8002
# RAG service (participant B). Until it is up the agent uses the built-in mock search.
RAG_API_URL=http://127.0.0.1:8003

# --- LLM endpoint (bootstrap default; the admin can change it in the UI) ---
# Protocol: openai_compatible | anthropic | google_gemini
LLM_PROTOCOL=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8010/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=Qwen3.6-35B-A3B

# --- Application ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=data
# Factory manual PDFs are not in git: point this at the folder holding the
# issued manuals (file names per data/manuals/manifest.json) or another
# access-controlled location.
MANUALS_DIR=data/manuals
